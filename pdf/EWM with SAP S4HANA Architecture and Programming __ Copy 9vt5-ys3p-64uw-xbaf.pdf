   <rdf:Alt>
    <rdf:li xml:lang='x-default'>¬© Rheinwerk Verlag, Bonn 2026</rdf:li>
   </rdf:Alt>
  </dc:rights>
  <dc:subject>
   <rdf:Bag>
    <rdf:li>Extend embedded and decentralized EWM with SAP S/4HANA!</rdf:li>
   </rdf:Bag>
  </dc:subject>
  <dc:title>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>EWM with SAP S/4HANA: Architecture and Programming</rdf:li>
   </rdf:Alt>
  </dc:title>
